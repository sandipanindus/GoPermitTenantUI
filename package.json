{
  "name": "stroyka",
  "version": "1.13.0",
  "scripts": {
    "ng": "ng",
    "start": "node --openssl-legacy-provider ./node_modules/@angular/cli/bin/ng serve --port 4200",
    "build": "node --openssl-legacy-provider ./node_modules/@angular/cli/bin/ng build",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "sprite": "svg-sprite --config src/sprite-config.json src/svg/*.svg",
    "start:ssr": "npm run build:ssr && npm run serve:ssr",
    "dev:ssr": "ng run stroyka:serve-ssr",
    "serve:ssr": "node dist/stroyka/server/main.js",
    "build:ssr": "ng build --configuration production && ng run stroyka:server:production",
    "prerender": "ng run stroyka:prerender"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^14.3.0",
    "@angular/common": "^14.3.0",
    "@angular/compiler": "^14.3.0",
    "@angular/core": "^14.3.0",
    "@angular/forms": "^14.3.0",
    "@angular/platform-browser": "^14.3.0",
    "@angular/platform-browser-dynamic": "^14.3.0",
    "@angular/platform-server": "^14.3.0",
    "@angular/router": "^14.3.0",
    "@fortawesome/fontawesome-free": "^5.13.1",
    "@m0t0r/ngx-slider": "^1.0.0",
    "@nguniversal/express-engine": "^10.0.0",
    "@types/jquery": "^3.5.1",
    "angular-bootstrap-datetimepicker": "^4.0.2",
    "angular2-material-datepicker": "^0.5.0",
    "autoprefixer": "^10.4.20",
    "bootstrap": "^4.5.2",
    "express": "^4.15.2",
    "jquery": "^3.5.1",
    "moment": "^2.27.0",
    "ng2-tooltip-directive": "^2.9.22",
    "ngx-bootstrap": "^5.5.0",
    "ngx-datetime-picker": "^3.0.0",
    "ngx-owl-carousel-o": "^3.1.1",
    "ngx-toastr": "^12.1.0",
    "open-iconic": "^1.1.1",
    "photoswipe": "^4.1.3",
    "postcss": "^8.5.3",
    "rxjs": "~6.5.5",
    "tailwindcss": "^3.4.17",
    "tslib": "^2.0.0",
    "zone.js": "~0.11.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^14.2.13",
    "@angular/cli": "^14.2.13",
    "@angular/compiler-cli": "^14.3.0",
    "@angular/language-service": "^14.3.0",
    "@nguniversal/builders": "^10.0.0",
    "@types/express": "^4.17.0",
    "@types/jasmine": "~3.6.0",
    "@types/jasminewd2": "~2.0.3",
    "@types/node": "^14.0.14",
    "codelyzer": "^6.0.0",
    "jasmine-core": "~3.6.0",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage-istanbul-reporter": "~3.0.2",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "^1.5.0",
    "protractor": "~7.0.0",
    "source-map-support": "^0.5.21",
    "svg-sprite": "^1.5.0",
    "ts-node": "~8.3.0",
    "tslint": "~6.1.2",
    "typescript": "~4.6.4"
  }
}
